# Django Secret Key
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Email Configuration
EMAIL_HOST=smtp.your.email.server
EMAIL_PORT=465
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password

# Database settings
DB_NAME=testUser
DB_USER=whoAmI
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=0.0.0.0
DB_PORT=5432

#Allow host
ALLOWED_HOSTS=127.0.0.1,localhost,hha.nwu.icu,preview.nwu.icu

# University settings
UNIVERSITY_MAIL_SUFFIX=nwu.edu.cn
UNIVERSITY_TEACHER_MAIL_SUFFIX=nwu.edu.cn
UNIVERSITY_STUDENT_MAIL_SUFFIX=stumail.nwu.edu.cn
UNIVERSITY_CHINESE_NAME=西北大学
UNIVERSITY_ENGLISH_NAME='Northwest University'
UNIVERSITY_ENGLISH_ABBREVIATION_NAME=NWU
WEBSITE_NAME=NWU.ICU
FRONTEND_URL=https://nwu.icu
SECURE_SSL_REDIRECT=True
TRUST_X_FORWARDED_PROTO=True
SECURE_HSTS_SECONDS=3600

# SuperUser Info
DEFAULT_SUPER_USER_ID=2147483000
DEFAULT_SUPER_USER_USERNAME=your_super_user_name_here
DEFAULT_SUPER_USER_PASSWORD=your_super_user_password_here
DEFAULT_SUPER_USER_EMAIL=super@example.com

# Default User Info
DEFAULT_USER_AVATAR_FILE_NAME=default_avatar.jpg
DEFAULT_USER_AVATAR_UUID=c3fd49e2-87ce-4980-9719-ac745774b6d3

# Annoymous User Info
ANONYMOUS_USER_AVATAR_FILE_NAME=annoymous_avatar.jpg
ANONYMOUS_USER_AVATAR_UUID=c3fd49e2-87ce-4980-9719-ac745774b6d2

# Other Website URL
RESOURCES_WEBSITE_URL=https://resour.nwu.icu
RESOURCE_DIRECTORY_CACHE_FILE=/app/data/resource_directories.json
# Django 上传文件和资源目录索引的宿主持久化目录。
MEDIA_STORAGE_HOST_PATH=./media
RESOURCE_INDEX_HOST_PATH=./data
# AList Local 存储驱动在宿主机上的物理根目录；该目录会挂载到 Django 容器。
RESOURCE_STORAGE_HOST_PATH=/absolute/path/to/alist/storage
# 非 Docker 启动时请改成同一个物理根目录；Docker Compose 会覆盖为 /resource-storage。
RESOURCE_STORAGE_ROOT=/absolute/path/to/alist/storage

# Telegram notification
TELEGRAM_BOT_API_TOKEN=
TELEGRAM_CHAT_ID=

# Throttle
NORMAL_THROTTLE_LOGIN='30/minute'
NORMAL_THROTTLE_NOT_LOGIN='30/minute'
EMAIL_THROTTLE_LOGIN='1/minute'
EMAIL_THROTTLE_NOT_LOGIN='1/minute'
