# Copy to .env.production and replace every CHANGE_ME value before deployment.
ENV_FILE=.env.production
TZ=Asia/Shanghai
SECRET_KEY='CHANGE_ME_generate_a_long_random_secret'
DEBUG=False
CAPTCHA_TEST_MODE=False
DISABLE_FILE_UPLOAD_CHMOD=False

DB_NAME=nwuicu
DB_USER=nwuicu
DB_PASSWORD='CHANGE_ME_database_password'
DB_HOST=db
DB_PORT=5432

ALLOWED_HOSTS=nwu.icu,www.nwu.icu
CSRF_TRUSTED_ORIGINS=https://nwu.icu,https://www.nwu.icu
FRONTEND_URL=https://nwu.icu
ADMIN_PUBLIC_URL=https://nwu.icu
WEBAUTHN_RP_ID=nwu.icu
WEBAUTHN_RP_NAME=NWU.ICU
WEBAUTHN_EXPECTED_ORIGINS=https://nwu.icu,https://www.nwu.icu
SECURE_SSL_REDIRECT=True
TRUST_X_FORWARDED_PROTO=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

UNIVERSITY_MAIL_SUFFIX=nwu.edu.cn
UNIVERSITY_TEACHER_MAIL_SUFFIX=nwu.edu.cn
UNIVERSITY_STUDENT_MAIL_SUFFIX=stumail.nwu.edu.cn
UNIVERSITY_CHINESE_NAME=西北大学
UNIVERSITY_ENGLISH_NAME='Northwest University'
UNIVERSITY_ENGLISH_ABBREVIATION_NAME=NWU
WEBSITE_NAME=NWU.ICU

DEFAULT_SUPER_USER_ID=2147483000
DEFAULT_SUPER_USER_USERNAME='CHANGE_ME_admin_username'
DEFAULT_SUPER_USER_PASSWORD='CHANGE_ME_admin_password'
DEFAULT_SUPER_USER_EMAIL='CHANGE_ME_admin_email'
DEFAULT_USER_AVATAR_FILE_NAME=default_avatar.jpg
DEFAULT_USER_AVATAR_UUID=c3fd49e2-87ce-4980-9719-ac745774b6d3
ANONYMOUS_USER_AVATAR_FILE_NAME=annoymous_avatar.jpg
ANONYMOUS_USER_AVATAR_UUID=c3fd49e2-87ce-4980-9719-ac745774b6d2

EMAIL_HOST='CHANGE_ME_smtp_host'
EMAIL_PORT=465
EMAIL_HOST_USER='CHANGE_ME_smtp_user'
EMAIL_HOST_PASSWORD='CHANGE_ME_smtp_password'

RESOURCES_WEBSITE_URL=https://resour.nwu.icu
RESOURCE_DIRECTORY_CACHE_FILE=/app/data/resource_directories.json
MEDIA_STORAGE_HOST_PATH=/srv/nwuicu/media
STATIC_STORAGE_HOST_PATH=/srv/nwuicu/static
RESOURCE_INDEX_HOST_PATH=/srv/nwuicu/index
RESOURCE_STORAGE_HOST_PATH=/srv/nwuicu/resources
RESOURCE_STORAGE_ROOT=/resource-storage

TELEGRAM_BOT_API_TOKEN=
TELEGRAM_CHAT_ID=

THROTTLE_CACHE_ALIAS=default
THROTTLE_BROWSER_COOKIE_NAME=nwu_client_id
THROTTLE_BROWSER_COOKIE_MAX_AGE=31536000
TRUSTED_PROXY_COUNT=2
CAPTCHA_PROOF_TTL=120
CAPTCHA_VALIDATION_RATE_LIMIT_ENABLED=True
CAPTCHA_VALIDATION_ANON_RATE=30/minute
CAPTCHA_VALIDATION_USER_RATE=30/minute
LOGIN_RATE_LIMIT_ENABLED=True
LOGIN_CAPTCHA_AFTER_FAILURES=5
LOGIN_CAPTCHA_ATTEMPTS=3
LOGIN_CAPTCHA_TTL=600
LOGIN_FAILURE_TTL=3600
LOGIN_BACKOFF_SECONDS=30,60,120,300
LOGIN_EMERGENCY_IP_RATE=300/minute
LOGIN_THROTTLE_USERNAME=5/minute
REGISTER_RATE_LIMIT_ENABLED=True
REGISTER_ATTEMPT_RATE=10/hour
REGISTER_SUCCESS_RATE=3/day
REGISTER_TARGET_RATE=5/hour
REVIEW_WRITE_RATE_LIMIT_ENABLED=True
REVIEW_WRITE_BURST_RATE=5/minute
REVIEW_WRITE_DAILY_RATE=30/day
GUESTBOOK_WRITE_RATE_LIMIT_ENABLED=True
GUESTBOOK_WRITE_BURST_RATE=5/minute
GUESTBOOK_WRITE_DAILY_RATE=30/day
REPLY_WRITE_RATE_LIMIT_ENABLED=True
REPLY_WRITE_BURST_RATE=10/minute
REPLY_WRITE_DAILY_RATE=100/day
CATALOG_WRITE_RATE_LIMIT_ENABLED=True
CATALOG_WRITE_BURST_RATE=5/minute
CATALOG_WRITE_DAILY_RATE=20/day
MESSAGE_WRITE_RATE_LIMIT_ENABLED=True
MESSAGE_WRITE_RATE=30/minute
SEARCH_RATE_LIMIT_ENABLED=True
SEARCH_ANON_RATE=30/minute
SEARCH_USER_RATE=30/minute
INTERACTION_RATE_LIMIT_ENABLED=True
INTERACTION_ANON_RATE=30/minute
INTERACTION_USER_RATE=30/minute
EMAIL_RATE_LIMIT_ENABLED=True
EMAIL_THROTTLE_LOGIN=1/minute
EMAIL_THROTTLE_NOT_LOGIN=1/minute
EMAIL_THROTTLE_ADDRESS=2/minute
ADMIN_PASSKEY_RATE_LIMIT_ENABLED=True
ADMIN_PASSKEY_USER_THROTTLE=10/minute
ADMIN_PASSKEY_IP_THROTTLE=30/minute
RESOURCE_DOWNLOAD_GATE_ENABLED=False
RESOURCE_DOWNLOAD_ANON_RATE=10/hour
RESOURCE_DOWNLOAD_USER_RATE=50/hour
RESOURCE_DOWNLOAD_TICKET_TTL=600
RESOURCE_DOWNLOAD_DEDUPE_TTL=300

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=300
PROXY_NETWORK_NAME=web-proxy
UPLOAD_UID=10001
UPLOAD_GID=10001
