# Official image: ghcr.io/umami-software/umami
# Fill in a published fixed version tag or @sha256 digest; do not use latest.
UMAMI_IMAGE=ghcr.io/umami-software/umami:3.4.0

# Check the existing PostgreSQL container's network before starting.
UMAMI_DB_NETWORK=nwuicu_app-network
# Use the dedicated umami user/database, not the Django database credentials.
# URI-encode any reserved characters in the password (or use a random hex password).
UMAMI_DATABASE_URL=postgresql://umami:REPLACE_WITH_DATABASE_PASSWORD@db:5432/umami

# Generate independent secrets with: openssl rand -hex 32
UMAMI_APP_SECRET=
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=

# Trial limits, not measured minimum memory requirements.
UMAMI_MEMORY_LIMIT=512m
UMAMI_NODE_OPTIONS=--max-old-space-size=256
UMAMI_HOST_PORT=13000
