#!/usr/bin/env bash

set -Eeuo pipefail

umask 077

readonly container_name="pgsql"
readonly backup_root="/root/nwuicuBack/daily"
readonly timestamp="$(date +%Y%m%d_%H%M%S)"
readonly work_dir="${backup_root}/.incomplete_${timestamp}"
readonly final_dir="${backup_root}/${timestamp}"
readonly umami_database="umami"

exec 9>/run/lock/nwuicu-db-backup.lock
if ! flock -n 9; then
    echo "Another NWU.ICU database backup is already running; skipping." >&2
    exit 0
fi

install -d -m 700 "${backup_root}"
test ! -e "${work_dir}"
test ! -e "${final_dir}"
mkdir -m 700 -- "${work_dir}"

db_user="$(docker exec "${container_name}" printenv POSTGRES_USER)"
db_name="$(docker exec "${container_name}" printenv POSTGRES_DB)"
test -n "${db_user}"
test -n "${db_name}"
if [[ "${db_name}" == "${umami_database}" ]]; then
    echo "POSTGRES_DB must identify the business database, not umami." >&2
    exit 1
fi

echo "Starting full PostgreSQL backups for ${db_name} and ${umami_database} at $(date --iso-8601=seconds)."

backup_files=()
backup_database() {
    local database="$1" prefix="$2"
    local dump_name="${prefix}_full_${timestamp}.dump"
    local list_name="${prefix}_full_${timestamp}.list"

    docker exec "${container_name}" \
        pg_dump -U "${db_user}" -d "${database}" \
        -Fc --no-owner --no-privileges \
        > "${work_dir}/${dump_name}"
    test -s "${work_dir}/${dump_name}"

    # Read/decompress the entire archive; a valid TOC alone cannot prove this.
    docker exec -i "${container_name}" pg_restore --file=/dev/null \
        < "${work_dir}/${dump_name}"
    docker exec -i "${container_name}" pg_restore --list \
        < "${work_dir}/${dump_name}" \
        > "${work_dir}/${list_name}"
    test -s "${work_dir}/${list_name}"
    backup_files+=("${dump_name}" "${list_name}")
}

# Either database failing leaves .incomplete_* and fails the systemd service.
backup_database "${db_name}" nwuicu
backup_database "${umami_database}" umami

cat > "${work_dir}/metadata.txt" <<EOF
created_at=$(date --iso-8601=seconds)
container=${container_name}
database=${db_name}
umami_database=${umami_database}
backup_format_version=2
format=PostgreSQL custom archive
EOF

(
    cd "${work_dir}"
    sha256sum "${backup_files[@]}" metadata.txt > SHA256SUMS
    sha256sum -c SHA256SUMS
)

mv -- "${work_dir}" "${final_dir}"
echo "Completed full PostgreSQL backups for ${db_name} and ${umami_database} at ${final_dir}."
