# Copy to .env.windows. This file is for local Windows + Docker debugging only.
ENV_FILE=.env.windows
SECRET_KEY=windows-debug-only-secret-key-change-if-shared
DEBUG=True
CAPTCHA_TEST_MODE=False
DISABLE_FILE_UPLOAD_CHMOD=True

# PostgreSQL service from docker-compose.yaml
DB_NAME=nwuicu_debug
DB_USER=nwuicu_debug
DB_PASSWORD=nwuicu_debug_password
DB_HOST=db
DB_PORT=5432

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
ADMIN_PUBLIC_URL=http://localhost:8000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME='NWU.ICU Debug'
WEBAUTHN_EXPECTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=False
TRUST_X_FORWARDED_PROTO=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

UNIVERSITY_MAIL_SUFFIX=nwu.edu.cn
UNIVERSITY_TEACHER_MAIL_SUFFIX=nwu.edu.cn
UNIVERSITY_STUDENT_MAIL_SUFFIX=stumail.nwu.edu.cn
UNIVERSITY_CHINESE_NAME=西北大学
UNIVERSITY_ENGLISH_NAME='Northwest University'
UNIVERSITY_ENGLISH_ABBREVIATION_NAME=NWU
WEBSITE_NAME='NWU.ICU Debug'

DEFAULT_SUPER_USER_ID=2147483000
DEFAULT_SUPER_USER_USERNAME=debug_admin
DEFAULT_SUPER_USER_PASSWORD=debug_admin_change_me
DEFAULT_SUPER_USER_EMAIL=debug-admin@example.com
DEFAULT_USER_AVATAR_FILE_NAME=default_avatar.jpg
DEFAULT_USER_AVATAR_UUID=c3fd49e2-87ce-4980-9719-ac745774b6d3
ANONYMOUS_USER_AVATAR_FILE_NAME=annoymous_avatar.jpg
ANONYMOUS_USER_AVATAR_UUID=c3fd49e2-87ce-4980-9719-ac745774b6d2

EMAIL_HOST=host.docker.internal
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

RESOURCES_WEBSITE_URL=https://resour.nwu.icu
RESOURCE_DIRECTORY_CACHE_FILE=/app/data/resource_directories.json
MEDIA_STORAGE_HOST_PATH=./media
RESOURCE_INDEX_HOST_PATH=./data
RESOURCE_STORAGE_HOST_PATH=./resource-storage
RESOURCE_STORAGE_ROOT=/resource-storage

TELEGRAM_BOT_API_TOKEN=
TELEGRAM_CHAT_ID=

NORMAL_THROTTLE_LOGIN=1000/minute
NORMAL_THROTTLE_NOT_LOGIN=1000/minute
EMAIL_THROTTLE_LOGIN=1000/minute
EMAIL_THROTTLE_NOT_LOGIN=1000/minute
EMAIL_THROTTLE_ADDRESS=1000/minute
LOGIN_THROTTLE_IP=1000/minute
LOGIN_THROTTLE_USERNAME=1000/minute
ADMIN_PASSKEY_USER_THROTTLE=1000/minute
ADMIN_PASSKEY_IP_THROTTLE=1000/minute

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=300
